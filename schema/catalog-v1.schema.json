{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uwpath.com/schemas/catalog-v1.schema.json",
  "title": "UWPath versioned academic catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "calendar",
    "courses",
    "programs",
    "quality"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "calendar": { "$ref": "#/$defs/calendar" },
    "courses": {
      "type": "array",
      "items": { "$ref": "#/$defs/course" }
    },
    "programs": {
      "type": "array",
      "items": { "$ref": "#/$defs/program" }
    },
    "quality": { "$ref": "#/$defs/quality" }
  },
  "$defs": {
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "academic_year",
        "title",
        "source",
        "source_id",
        "source_url",
        "starts_on",
        "ends_on"
      ],
      "properties": {
        "academic_year": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{4}$" },
        "title": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "starts_on": { "type": "string" },
        "ends_on": { "type": "string" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source_text"],
      "properties": {
        "type": {
          "enum": ["all", "at_least", "none_of", "course", "manual"]
        },
        "source_text": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/rule" }
        },
        "count": { "type": "integer", "minimum": 0 },
        "course_code": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "nullableRule": {
      "oneOf": [
        { "$ref": "#/$defs/rule" },
        { "type": "null" }
      ]
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_record_id",
        "course_code",
        "source_course_code",
        "subject",
        "number",
        "title",
        "description",
        "units",
        "prerequisites_html",
        "corequisites_html",
        "antirequisites_html",
        "prerequisite_rule",
        "corequisite_rule",
        "antirequisite_rule",
        "source_url",
        "source_hash"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source_record_id": { "type": "string", "minLength": 1 },
        "course_code": { "type": "string", "minLength": 1 },
        "source_course_code": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "number": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "units": { "type": ["string", "null"] },
        "prerequisites_html": { "type": "string" },
        "corequisites_html": { "type": "string" },
        "antirequisites_html": { "type": "string" },
        "prerequisite_rule": { "$ref": "#/$defs/nullableRule" },
        "corequisite_rule": { "$ref": "#/$defs/nullableRule" },
        "antirequisite_rule": { "$ref": "#/$defs/nullableRule" },
        "source_url": { "type": "string", "format": "uri" },
        "source_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_record_id",
        "code",
        "title",
        "credential_type",
        "field_of_study",
        "faculty",
        "requirements_html",
        "requirement_rule",
        "source_url",
        "source_hash"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source_record_id": { "type": "string", "minLength": 1 },
        "code": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "credential_type": { "type": "string" },
        "field_of_study": { "type": "string" },
        "faculty": { "type": "string" },
        "requirements_html": { "type": "string" },
        "requirement_rule": { "$ref": "#/$defs/nullableRule" },
        "source_url": { "type": "string", "format": "uri" },
        "source_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "course_count",
        "program_count",
        "rule_count",
        "manual_rule_count",
        "duplicate_course_codes",
        "dangling_course_references",
        "external_course_references",
        "warnings",
        "publishable",
        "planner_ready"
      ],
      "properties": {
        "course_count": { "type": "integer", "minimum": 0 },
        "program_count": { "type": "integer", "minimum": 0 },
        "rule_count": { "type": "integer", "minimum": 0 },
        "manual_rule_count": { "type": "integer", "minimum": 0 },
        "duplicate_course_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dangling_course_references": {
          "type": "array",
          "items": { "type": "string" }
        },
        "external_course_references": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "publishable": { "type": "boolean" },
        "planner_ready": { "type": "boolean" }
      }
    }
  }
}
